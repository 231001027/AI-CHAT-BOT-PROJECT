# ── FastAPI service environment ───────────────────────────────────────────────
# Copy this file to .env and fill in your values before starting the server.

# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Host and port uvicorn binds to
HOST=0.0.0.0
PORT=8000

# Set to "production" in deployed environments
ENVIRONMENT=development

# SQLite by default (file created under backend/fastapi/data/).
# For Postgres: DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/hearconnect
# DATABASE_URL=sqlite:///./data/hearconnect.db
