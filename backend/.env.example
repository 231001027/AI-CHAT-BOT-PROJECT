# ── NIEPMD Audiology backend ─────────────────────────────────────────────────
# Copy to .env and adjust. Prefer exporting DATABASE_URL when using Compose
# Postgres on host port 55432 (see repo-root docker-compose.yml).

APP_NAME=NIEPMD Audiology API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

# Frontend origins (Vite default 5173)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Compose publishes Postgres as localhost:55432
DATABASE_URL=postgresql+asyncpg://nipmed:nipmed@localhost:55432/nipmed

REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SECONDS=86400

QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=niepmd_documents

# Local embeddings (no API key). Alternatives: openai | voyage
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# LLM for AI explanations / phrasing.
# Prefer local Ollama in development: LLM_PROVIDER=ollama
# auto prefers Anthropic → Gemini → Ollama (when OLLAMA_ENABLED=true).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral:latest
OLLAMA_ENABLED=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_MINUTES=10080
