{
  "name": "hearconnect-api-gateway",
  "version": "1.0.0",
  "description": "Node.js Express API gateway for HearConnect — proxies to FastAPI with rate-limiting and logging.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-rate-limit": "7.3.1",
    "http-proxy-middleware": "3.0.0",
    "morgan": "1.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
