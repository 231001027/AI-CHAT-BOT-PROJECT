# ── Node.js API Gateway environment ──────────────────────────────────────────
# Copy this file to .env and fill in your values before starting the server.

# Port the Express gateway listens on
GATEWAY_PORT=3000

# Base URL of the FastAPI service this gateway proxies to
FASTAPI_URL=http://localhost:8000

# Origin of the React frontend (used for CORS)
FRONTEND_URL=http://localhost:5173

# "development" | "production"
NODE_ENV=development
