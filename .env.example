# ── NIEPMD Audiology (repo root) ─────────────────────────────────────────────
# Used by docker compose (${VAR} interpolation). Prefer putting real secrets in
# backend/.env as well — the API loads that file directly.
# Copy values from backend/.env; do not commit real keys.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_ENABLED=true
JWT_SECRET=change-me-to-a-long-random-string
