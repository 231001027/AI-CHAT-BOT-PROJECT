# ── React frontend environment ────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Vite exposes only variables prefixed with VITE_ to the browser bundle.

# URL of the Node.js API gateway (the frontend talks to this, not FastAPI directly)
VITE_API_BASE_URL=http://localhost:3000

# Supabase credentials (get from Supabase dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
